{
  "name": "tembo",
  "productName": "Tembo",
  "version": "0.5.0",
  "description": "Безопасный разборщик файлов для Windows",
  "main": "src/main.js",
  "license": "MIT",
  "author": "iziziz333",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.iziziz333.tembo",
    "productName": "Tembo",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Tembo-${version}-win.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Tembo-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "iziziz333",
        "repo": "tembo",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
